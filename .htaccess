# ----------------------------------------------------------------------
# Security & Performance Configuration for AL FATIHA INSTITUTE
# ----------------------------------------------------------------------

# 1. Prevent Directory Browsing
Options -Indexes

# 2. Set default character set
AddDefaultCharset UTF-8

# 3. Protect sensitive files from direct web access
<FilesMatch "^(\.env|\.git|database\.sql|schema\.sql|composer\.(json|lock)|package\.(json|lock)|\.gitignore)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Protect config files
<Files "db.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# 5. URL Rewriting & HTTPS Enforcement (Uncomment if needed)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect to HTTPS (Uncomment on live production with SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

